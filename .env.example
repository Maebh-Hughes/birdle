# BIRDLE configuration. Copy this file to `.env` in the repo root and fill it in.
# `.env` is git-ignored; never commit real secrets. The server loads this file and
# Vite reads it too (envDir '..'); Vite exposes only VITE_-prefixed variables to
# the browser bundle.

# Developer Portal -> your app -> OAuth2 -> Client ID. Public: the server uses it
# for the token exchange and hands it to the client at startup (GET /api/config),
# so one build (or Docker image) works for any Discord application.
DISCORD_CLIENT_ID=           # Discord application id (public; read by the server at runtime)

# Optional, older alias of DISCORD_CLIENT_ID. The server accepts it when
# DISCORD_CLIENT_ID is unset, and Vite compiles it into the client at build time
# (the client then skips GET /api/config). If both are set they must match.
# VITE_DISCORD_CLIENT_ID=      # build-time client id (optional; prefer DISCORD_CLIENT_ID)

# Developer Portal -> OAuth2 -> Client Secret. Never expose it to the client.
DISCORD_CLIENT_SECRET=       # OAuth2 client secret (server only)

# Port of the Express server: /api in dev (Vite proxies to it), /api plus the
# built client in production.
PORT=3001

# JSON file where the server persists games and stats (written atomically).
DATA_FILE=./server/data/birdle-db.json

# Seed for the deterministic daily puzzle order. Changing it changes every
# future daily answer, so set it once and keep it. `birdle` is fine for local
# development, but anyone who knows the seed and the word list can compute every
# answer: for a real deployment use a private random value (for example the
# output of `node -e "console.log(crypto.randomUUID())"`). The server warns in
# production while it is still the default.
PUZZLE_SEED=birdle

# Accept `mock:<id>:<name>` bearer tokens for local browser play without Discord.
# When unset: on if NODE_ENV !== 'production', off in production.
# BIRDLE_ALLOW_MOCK_AUTH=true   # dev only; defaults to on outside production

# Port the browser uses for Vite's HMR websocket; 443 when Discord reaches the
# dev server through an HTTPS tunnel (e.g. cloudflared).
# VITE_HMR_CLIENT_PORT=443      # set when running the dev server behind a tunnel for Discord

# Hostnames the Vite dev server accepts in addition to *.trycloudflare.com.
# VITE_ALLOWED_HOSTS=           # extra dev-server hosts besides .trycloudflare.com (comma-separated)
